# Copy to .env and fill in locally. Never commit .env.
# This file lists variable names only — do not put real values here.
# The server reads .env from the repository root when it exists; variables
# already set in the environment (e.g. by the MCP client config) take precedence.

# Path to config.yaml. Optional; `--config <path>` takes precedence,
# and the repository's config.yaml is used when neither is set.
AI_FOUNDATION_CONFIG=

# --- Task: Todoist ---
# Personal API token (Todoist → Settings → Integrations → Developer).
TODOIST_API_TOKEN=

# --- Schedule: Google Calendar (OAuth 2.0, Desktop app client) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Obtain with `npm run auth:google` after setting the client ID and secret.
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Phase 3 and later (not used yet) ---
# NOTION_API_TOKEN=
# OBSIDIAN_VAULT_PATH=
# GITHUB_TOKEN=
