# Copy to .env and fill in locally. Never commit .env.
# This file lists variable names only — do not put real values here.
# The server reads .env from the repository root when it exists; variables
# already set in the environment (e.g. by the MCP client config) take precedence.

# Path to config.yaml. Optional; `--config <path>` takes precedence,
# and the repository's config.yaml is used when neither is set.
AI_FOUNDATION_CONFIG=

# --- Task: Todoist ---
# Personal API token (Todoist → Settings → Integrations → Developer).
TODOIST_API_TOKEN=

# --- Schedule: Google Calendar (OAuth 2.0, Desktop app client) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Obtain with `npm run auth:google` after setting the client ID and secret.
# `npm run auth:google -- --drive` also grants Google Drive (one token for both).
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Google Drive verification probe (scripts/probe-google-drive.ts only) ---
# A folder in My Drive whose name starts with "AI Foundation Probe". The probe
# writes only files it creates there and moves them to the trash afterwards.
GOOGLE_DRIVE_PROBE_FOLDER_ID=
# Optional. The vault folder: the probe only reads its metadata (files.get, once).
GOOGLE_DRIVE_VAULT_FOLDER_ID=

# --- Collection: Notion ---
# Internal integration (connection) token. See README "Notion".
NOTION_API_TOKEN=

# --- Knowledge: Obsidian ---
# No credential. The vault path is configuration: set
# sources.knowledge.obsidian.vault_path in config.local.yaml (see README "Obsidian").

# --- Project: GitHub ---
# The repositories GitHub's /user/repos returns for this token are the projects
# (1 repository = 1 project). Use a fine-grained personal access token, choose
# the private repositories AI Foundation may see under "Repository access", and
# grant "Metadata: Read-only". Your own public repositories are listed whether
# selected or not. See README "GitHub".
GITHUB_TOKEN=

# --- REST API (npm run start:http / dev:http) ---
# Required by the HTTP server only (the MCP server does not read it): at least
# 32 printable ASCII characters, no spaces. Generate one with
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# Change it by updating this value and restarting the server.
AI_FOUNDATION_API_KEY=
# Optional. Host and port to listen on (defaults 127.0.0.1 and 8787);
# --host / --port take precedence. Expose it only behind HTTPS termination.
AI_FOUNDATION_HTTP_HOST=
AI_FOUNDATION_HTTP_PORT=
