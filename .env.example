# Copy to .env and fill in locally. Never commit .env.
# This file lists variable names only — do not put real values here.
# The server reads .env from the repository root when it exists; variables
# already set in the environment (e.g. by the MCP client config) take precedence.

# Path to config.yaml. Optional; `--config <path>` takes precedence,
# and the repository's config.yaml is used when neither is set.
AI_FOUNDATION_CONFIG=

# --- Task: Todoist ---
# Personal API token (Todoist → Settings → Integrations → Developer).
TODOIST_API_TOKEN=

# --- Schedule: Google Calendar (OAuth 2.0, Desktop app client) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Obtain with `npm run auth:google` after setting the client ID and secret.
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Collection: Notion ---
# Internal integration (connection) token. See README "Notion".
NOTION_API_TOKEN=

# --- Knowledge: Obsidian ---
# No credential. The vault path is configuration: set
# sources.knowledge.obsidian.vault_path in config.local.yaml (see README "Obsidian").

# --- Project: GitHub ---
# The repositories GitHub's /user/repos returns for this token are the projects
# (1 repository = 1 project). Use a fine-grained personal access token, choose
# the private repositories AI Foundation may see under "Repository access", and
# grant "Metadata: Read-only". Your own public repositories are listed whether
# selected or not. See README "GitHub".
GITHUB_TOKEN=
